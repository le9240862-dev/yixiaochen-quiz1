                    return;
                }
                
                subtitle.innerHTML = `以下是你刚刚遗忘的 <b style="color:var(--primary-color)">${wrongHistory.size}</b> 块灰暗碎片。点击图片，重新点亮视觉锚点并翻转复盘。`;
                
                wrongHistory.forEach(id => {
                    const q = originalQuizData.find(item => item.id === id);
                    if (!q || !q.imageUrl) return;

                    const card = document.createElement('div');
                    card.className = 'gallery-item';
                    card.innerHTML = `
                        <div class="gallery-inner">
                            <div class="gallery-front" style="background-image: url('${q.imageUrl}')"></div>
                            <div class="gallery-back">
                                <div class="gallery-back-title">${q.question.replace(/<[^>]+>/g, '').substring(3, 25)}...</div>
                                <div class="gallery-back-desc">${q.metaphor.replace(/<[^>]+>/g, '')}</div>
                            </div>
                        </div>
                    `;
                    card.onclick = function() { this.classList.toggle('flipped'); };
                    wrongGallery.appendChild(card);
                });
            }

        } catch (error) {
            alert("代码引擎异常: " + error.message);
        }
    </script>
</body>
</html>
